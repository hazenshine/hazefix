<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Leave a review — hazefix</title>
<style>
  :root {
    --bg: #0d1811;
    --panel: #142a1e;
    --panel-border: #23402d;
    --text-main: #eef2ee;
    --text-muted: #96ac9f;
    --copper: #c6824f;
    --copper-dim: #8a5c37;
    --signal: #7fd8a0;
    --danger: #e2685a;
    --font-body: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    --font-mono: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px 20px;
    background:
      radial-gradient(circle at 15% 10%, rgba(198,130,79,0.05), transparent 40%),
      var(--bg);
    font-family: var(--font-body);
    color: var(--text-main);
  }

  .panel {
    width: 100%;
    max-width: 560px;
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: 10px;
    padding: 40px 36px;
  }

  header h1 {
    font-size: 26px;
    font-weight: 650;
    letter-spacing: -0.01em;
    margin: 0 0 8px;
  }

  header p.lede {
    font-size: 14.5px;
    color: var(--text-muted);
    margin: 0 0 32px;
    max-width: 46ch;
    line-height: 1.5;
  }

  .field { margin-bottom: 24px; }

  label {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .refdes {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--copper);
    border: 1px solid var(--copper-dim);
    border-radius: 3px;
    padding: 1px 5px;
    line-height: 1.5;
  }

  .req { font-weight: 400; font-size: 12px; color: var(--danger); }
  .opt { font-weight: 400; font-size: 12px; color: var(--text-muted); }

  input[type="text"], textarea {
    width: 100%;
    padding: 11px 13px;
    font-size: 15px;
    font-family: inherit;
    color: var(--text-main);
    background: #0f1f16;
    border: 1px solid var(--panel-border);
    border-radius: 6px;
    outline: none;
    transition: border-color 0.15s;
  }

  input[type="text"]:focus, textarea:focus {
    border-color: var(--copper);
  }

  textarea { min-height: 130px; resize: vertical; line-height: 1.5; }

  .helper {
    font-size: 12px;
    color: var(--text-muted);
    margin: 8px 0 0;
  }

  /* honeypot: off-screen, not display:none, so it still gets filled by bots */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .dropzone {
    display: flex;
    align-items: center;
    gap: 12px;
    border: 1px dashed var(--panel-border);
    border-radius: 6px;
    padding: 12px 14px;
    background: #0f1f16;
  }

  .dropzone input[type="file"] {
    font-size: 13px;
    color: var(--text-muted);
    max-width: 100%;
  }

  .dropzone input[type="file"]::file-selector-button {
    background: transparent;
    color: var(--copper);
    border: 1px solid var(--copper-dim);
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 13px;
    cursor: pointer;
    margin-right: 10px;
  }

  .stars {
    display: inline-flex;
    flex-direction: row-reverse;
    gap: 4px;
  }

  .stars input { position: absolute; opacity: 0; pointer-events: none; }

  .stars label {
    font-size: 26px;
    line-height: 1;
    color: #2c4636;
    cursor: pointer;
    margin: 0;
    transition: color 0.12s;
  }

  .stars input:checked ~ label,
  .stars label:hover,
  .stars label:hover ~ label {
    color: var(--signal);
  }

  .stars input:focus-visible + label {
    outline: 2px solid var(--copper);
    outline-offset: 2px;
    border-radius: 3px;
  }

  .submit-btn {
    width: 100%;
    background: var(--copper);
    color: #14100b;
    padding: 13px 20px;
    font-size: 15px;
    font-weight: 650;
    font-family: inherit;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.15s, opacity 0.15s;
  }

  .submit-btn:hover { background: #d4915c; }
  .submit-btn:disabled { opacity: 0.55; cursor: not-allowed; }

  .status {
    min-height: 18px;
    font-size: 13px;
    margin: 12px 0 0;
    text-align: center;
  }

  .status.error { color: var(--danger); }
  .status.ok { color: var(--signal); }

  .confirm {
    text-align: center;
    padding: 12px 0;
  }

  .confirm .signal {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--signal);
    letter-spacing: 0.02em;
  }

  .confirm h2 { margin: 10px 0 8px; font-size: 20px; }
  .confirm p { color: var(--text-muted); font-size: 14px; line-height: 1.5; margin: 0; }
</style>
</head>
<body>

<main class="panel" id="panel">
  <header>
    <h1>Leave a review</h1>
    <p class="lede">Tell me what you thought of the project or repair. Every review is checked before it goes live — it won't appear instantly.</p>
  </header>

  <form id="reviewForm" novalidate>
    <div class="field">
      <label for="firstName"><span class="refdes">R1</span> Name <span class="req">required</span></label>
      <input type="text" id="firstName" name="firstName" required maxlength="80" autocomplete="given-name">
    </div>

    <div class="hp" aria-hidden="true">
      <label for="website">Leave this field blank</label>
      <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
    </div>

    <div class="field">
      <label for="imageUpload"><span class="refdes">R2</span> Photo <span class="opt">optional</span></label>
      <div class="dropzone">
        <input type="file" id="imageUpload" name="image" accept="image/png,image/jpeg,image/gif,image/webp">
      </div>
      <p class="helper">JPG, PNG, GIF or WebP — up to 5 MB.</p>
    </div>

    <div class="field">
      <label><span class="refdes">R3</span> Rating <span class="req">required</span></label>
      <div class="stars" role="radiogroup" aria-label="Rating">
        <input type="radio" id="star5" name="rating" value="5" required><label for="star5" title="Excellent">★</label>
        <input type="radio" id="star4" name="rating" value="4"><label for="star4" title="Good">★</label>
        <input type="radio" id="star3" name="rating" value="3"><label for="star3" title="Neutral">★</label>
        <input type="radio" id="star2" name="rating" value="2"><label for="star2" title="Poor">★</label>
        <input type="radio" id="star1" name="rating" value="1"><label for="star1" title="Terrible">★</label>
      </div>
      <p class="helper" id="ratingReadout">No rating selected yet.</p>
    </div>

    <div class="field">
      <label for="reviewText"><span class="refdes">R4</span> Review <span class="req">required</span></label>
      <textarea id="reviewText" name="review" required maxlength="2000"></textarea>
    </div>

    <button type="submit" class="submit-btn" id="submitBtn">Send review</button>
    <p class="status" id="formStatus" role="status"></p>
  </form>
</main>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
  // --- fill these in after you run supabase-schema.sql ---
  // Project Settings -> API -> Project URL / anon public key
  const SUPABASE_URL = "https://qnwolrpfbfepghpbyayc.supabase.co";
  const SUPABASE_ANON_KEY = "sb_publishable_3CTlSNBvufygcUI3xqXObg_Nn039a1s";
  // ---------------------------------------------------------

  const supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
  const MAX_BYTES = 5 * 1024 * 1024;
  const ALLOWED_TYPES = ["image/jpeg", "image/png", "image/gif", "image/webp"];
  const RATING_LABELS = { 1: "Terrible", 2: "Poor", 3: "Neutral", 4: "Good", 5: "Excellent" };

  const form = document.getElementById("reviewForm");
  const panel = document.getElementById("panel");
  const statusEl = document.getElementById("formStatus");
  const submitBtn = document.getElementById("submitBtn");
  const ratingReadout = document.getElementById("ratingReadout");
  const fileInput = document.getElementById("imageUpload");

  form.querySelectorAll('input[name="rating"]').forEach((input) => {
    input.addEventListener("change", () => {
      ratingReadout.textContent = `${input.value}/5 — ${RATING_LABELS[input.value]}`;
    });
  });

  function setStatus(message, kind) {
    statusEl.textContent = message;
    statusEl.className = "status" + (kind ? " " + kind : "");
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    // Honeypot: if this hidden field got filled, it was a bot.
    // Pretend success so it doesn't learn to avoid the trap.
    if (form.website.value.trim() !== "") {
      showConfirmation();
      return;
    }

    const firstName = form.firstName.value.trim();
    const ratingInput = form.querySelector('input[name="rating"]:checked');
    const reviewText = form.reviewText.value.trim();
    const file = fileInput.files[0];

    if (!firstName || !ratingInput || !reviewText) {
      setStatus("Fill in your name, a rating, and a review.", "error");
      return;
    }

    if (file) {
      if (!ALLOWED_TYPES.includes(file.type)) {
        setStatus("That file type isn't supported. Use JPG, PNG, GIF or WebP.", "error");
        return;
      }
      if (file.size > MAX_BYTES) {
        setStatus("That image is over 5 MB. Use a smaller file.", "error");
        return;
      }
    }

    submitBtn.disabled = true;
    setStatus("Sending…");

    try {
      let imagePath = null;

      if (file) {
        const ext = file.name.split(".").pop();
        const path = `${crypto.randomUUID()}.${ext}`;
        const { error: uploadError } = await supabaseClient
          .storage.from("review-images")
          .upload(path, file, { cacheControl: "3600", upsert: false });
        if (uploadError) throw uploadError;
        imagePath = path;
      }

      const { error: insertError } = await supabaseClient.from("reviews").insert({
        first_name: firstName,
        rating: Number(ratingInput.value),
        review_text: reviewText,
        image_path: imagePath,
        is_approved: false,
      });
      if (insertError) throw insertError;

      showConfirmation();
    } catch (err) {
      console.error(err);
      setStatus("Something went wrong sending that. Try again in a moment.", "error");
      submitBtn.disabled = false;
    }
  });

  function showConfirmation() {
    panel.innerHTML = `
      <div class="confirm">
        <p class="signal">STATUS: RECEIVED</p>
        <h2>Review received</h2>
        <p>It's in the queue and will appear on the site once it's checked.</p>
      </div>
    `;
  }
</script>

</body>
</html>
